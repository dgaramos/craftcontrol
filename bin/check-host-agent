#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

"$PYTHON" -m pytest services/host-agent/tests/ \
  --cov=services/host-agent/host_agent \
  --cov-report=xml:coverage-host-agent.xml \
  -v
echo "host-agent gate: ok"
