#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

mkdir -p test-results
"$PYTHON" -m pytest apps/server/tests/test_agent_workflows.py \
  --cov=test_agent_workflows \
  --cov-report=xml:coverage-dr-agents.xml \
  --junit-xml=test-results/dr-agents.xml \
  -v
echo "dr-agents gate: ok"
