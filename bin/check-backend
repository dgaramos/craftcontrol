#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

"$PYTHON" -m compileall -q \
  apps/server/minecraft_manager apps/server/app.py apps/server/wsgi.py app.py wsgi.py
mkdir -p test-results
"$PYTHON" -m pytest apps/server/tests/ \
  --ignore=apps/server/tests/test_agent_workflows.py \
  --cov=apps/server/minecraft_manager \
  --cov-report=xml:coverage.xml \
  --junit-xml=test-results/results.xml \
  -v
echo "backend gate: ok"
