#!/usr/bin/env bash
set -euo pipefail

readonly EXPECTED_DEPLOY_ROOT="/mnt/storage/docker/craftcontrol"
SOURCE_ROOT="$(realpath "$(git rev-parse --show-toplevel)")"
DEPLOY_ROOT="$(realpath "${CRAFTCONTROL_DEPLOY_ROOT:-$EXPECTED_DEPLOY_ROOT}")"
ACTION="deploy"
ROLLBACK_VERSION=""

if [[ "${1:-}" == "--check" ]]; then
  ACTION="check"
elif [[ "${1:-}" == "--prepare" && $# -eq 1 ]]; then
  ACTION="prepare"
elif [[ "${1:-}" == "--activate" && $# -eq 1 ]]; then
  ACTION="activate"
elif [[ "${1:-}" == "--rollback" && -n "${2:-}" && $# -eq 2 ]]; then
  ACTION="rollback"
  ROLLBACK_VERSION="$2"
elif [[ $# -gt 0 ]]; then
  echo "usage: bin/deploy-craftcontrol-backend [--check | --prepare | --activate | --rollback VERSION]" >&2
  exit 2
fi

readonly SOURCE_ROOT DEPLOY_ROOT ACTION ROLLBACK_VERSION
readonly COMPOSE_FILE="$DEPLOY_ROOT/docker-compose.split.yml"
readonly DATABASE_FILE="$DEPLOY_ROOT/data/manager.db"
readonly BEDROCK_ROOT="$(realpath "$DEPLOY_ROOT/../minecraft-bedrock")"

fail() { echo "backend deploy refused: $*" >&2; exit 1; }
compose() { docker compose --project-directory "$DEPLOY_ROOT" --file "$COMPOSE_FILE" "$@"; }
mount_source() {
  local destination="$1"
  docker inspect craftcontrol-backend --format '{{range .Mounts}}{{println .Source "|" .Destination}}{{end}}' \
    | awk -F ' \| ' -v destination="$destination" '$2 == destination {print $1}'
}
validate_mounts() {
  [[ "$(mount_source /data)" == "$DEPLOY_ROOT/data" ]] || fail "backend /data mount is invalid"
  [[ "$(mount_source /minecraft-project)" == "$BEDROCK_ROOT" ]] || fail "backend Bedrock mount is invalid"
}
validate_database() {
  [[ "$(compose exec -T craftcontrol-backend python -c 'import sqlite3; c=sqlite3.connect("/data/manager.db"); print(c.execute("PRAGMA quick_check").fetchone()[0])')" == "ok" ]] \
    || fail "SQLite integrity check failed"
}
prepare_forward_image() {
  git -C "$SOURCE_ROOT" ls-files -z apps/server packages packs bin/craftcontrol docker-compose.split.yml versions.env \
    | rsync -a --from0 --files-from=- "$SOURCE_ROOT/" "$DEPLOY_ROOT/"
  for attempt in 1 2 3; do
    if compose build craftcontrol-backend; then
      return
    fi
    [[ "$attempt" == "3" ]] && fail "backend image build failed after $attempt attempts"
    echo "backend image build failed; retrying ($attempt/3)" >&2
    sleep 5
  done
}
activate_forward_image() {
  docker image inspect "craftcontrol-backend:$CRAFTCONTROL_BACKEND_VERSION" >/dev/null
  backup_output="$(compose exec -T craftcontrol-backend craftcontrol backup create)"
  backup_id="$(python -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$backup_output")"
  compose exec -T craftcontrol-backend craftcontrol backup verify "$backup_id" >/dev/null
  compose up -d --no-deps craftcontrol-backend
  deployed_version="$CRAFTCONTROL_BACKEND_VERSION"
}

[[ "$DEPLOY_ROOT" == "$EXPECTED_DEPLOY_ROOT" || -n "${CRAFTCONTROL_DEPLOY_ROOT:-}" ]] || fail "unexpected deploy root"
[[ "$SOURCE_ROOT" != "$DEPLOY_ROOT" ]] || fail "source and deploy roots must be different"
[[ "$(git -C "$SOURCE_ROOT" branch --show-current)" == "main" ]] || fail "source checkout must be on main"
[[ -z "$(git -C "$SOURCE_ROOT" status --porcelain)" ]] || fail "source checkout is not clean"
source_revision="$(git -C "$SOURCE_ROOT" rev-parse HEAD)"
for remote in github origin; do
  [[ "$(git -C "$SOURCE_ROOT" ls-remote "$remote" refs/heads/main | awk '{print $1}')" == "$source_revision" ]] \
    || fail "$remote/main does not match the source revision"
done
[[ -f "$COMPOSE_FILE" ]] || fail "missing split Compose file"
[[ -f "$DATABASE_FILE" ]] || fail "missing production database"
docker inspect craftcontrol-frontend craftcontrol-backend >/dev/null 2>&1 \
  || fail "split production topology is not active"

source "$SOURCE_ROOT/versions.env"
export CRAFTCONTROL_FRONTEND_VERSION CRAFTCONTROL_BACKEND_VERSION CRAFTCONTROL_RELEASE_PAIR
compose config --quiet
validate_mounts
validate_database

if [[ "$ACTION" == "check" ]]; then
  echo "backend deploy preflight: ok version=$CRAFTCONTROL_BACKEND_VERSION pair=$CRAFTCONTROL_RELEASE_PAIR"
  exit 0
fi

frontend_id="$(docker inspect craftcontrol-frontend --format '{{.Id}}')"

if [[ "$ACTION" == "prepare" ]]; then
  prepare_forward_image
  echo "backend deploy preparation: ok version=$CRAFTCONTROL_BACKEND_VERSION"
  exit 0
elif [[ "$ACTION" == "activate" ]]; then
  activate_forward_image
elif [[ "$ACTION" == "rollback" ]]; then
  backup_output="$(compose exec -T craftcontrol-backend craftcontrol backup create)"
  backup_id="$(python -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$backup_output")"
  compose exec -T craftcontrol-backend craftcontrol backup verify "$backup_id" >/dev/null
  docker image inspect "craftcontrol-backend:$ROLLBACK_VERSION" >/dev/null 2>&1 \
    || fail "rollback image craftcontrol-backend:$ROLLBACK_VERSION is unavailable"
  CRAFTCONTROL_BACKEND_VERSION="$ROLLBACK_VERSION" compose up -d --no-deps craftcontrol-backend
  deployed_version="$ROLLBACK_VERSION"
else
  prepare_forward_image
  activate_forward_image
fi

for _ in $(seq 1 30); do
  [[ "$(docker inspect craftcontrol-backend --format '{{.State.Health.Status}}' 2>/dev/null || true)" == "healthy" ]] && break
  sleep 2
done
[[ "$(docker inspect craftcontrol-backend --format '{{.State.Health.Status}}')" == "healthy" ]] \
  || fail "backend did not become healthy"
[[ "$(docker inspect craftcontrol-frontend --format '{{.Id}}')" == "$frontend_id" ]] \
  || fail "frontend was recreated during backend deployment"
validate_mounts
validate_database

frontend_port="${CRAFTCONTROL_SPLIT_PORT:-8082}"
curl --fail --silent --show-error "http://127.0.0.1:$frontend_port/healthz" >/dev/null
curl --fail --silent --show-error "http://127.0.0.1:$frontend_port/api/health" >/dev/null
[[ "$(curl --silent --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$frontend_port/api/auth/me")" == "401" ]] \
  || fail "anonymous authentication canary did not return 401"
compose exec -T craftcontrol-backend craftcontrol backup list >/dev/null
[[ "$(docker inspect minecraft-bedrock --format '{{.State.Health.Status}}')" == "healthy" ]] \
  || fail "Bedrock is not healthy"

echo "backend deploy complete: version=$deployed_version frontend=unchanged backup=$backup_id"
