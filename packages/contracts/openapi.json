{
  "openapi": "3.1.0",
  "info": {
    "title": "CraftControl API",
    "version": "1.0.0",
    "description": "Same-origin API for CraftControl. Authentication uses an HttpOnly session cookie. Every non-safe authenticated request also requires the session-bound X-CSRF-Token returned by /api/auth/me. Swagger UI obtains that token for Try it out requests; backend capabilities remain authoritative."
  },
  "servers": [{"url": "/", "description": "Current CraftControl origin"}],
  "security": [{"cookieAuth": []}],
  "tags": [
    {"name": "System"}, {"name": "Authentication"}, {"name": "Configuration"},
    {"name": "Players"}, {"name": "Analytics"}, {"name": "Telemetry"},
    {"name": "Server"}, {"name": "World"}
  ],
  "paths": {
    "/api/health": {"get": {"tags": ["System"], "operationId": "health", "summary": "Check backend health", "security": [], "responses": {"200": {"$ref": "#/components/responses/Ok"}}}},
    "/api/schema": {"get": {"tags": ["Configuration"], "operationId": "getSchema", "summary": "Get editable settings and gamerule definitions", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/config": {
      "get": {"tags": ["Configuration"], "operationId": "getConfig", "summary": "Get current persistent configuration", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "put": {"tags": ["Configuration"], "operationId": "updateConfig", "summary": "Validate and stage persistent configuration", "x-craftcontrol-capability": "config.write", "parameters": [{"$ref": "#/components/parameters/CsrfToken"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/api/state": {"get": {"tags": ["System"], "operationId": "getState", "summary": "Get the reconciled public manager state", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/status": {"get": {"tags": ["Server"], "operationId": "getServerStatus", "summary": "Get Bedrock container status", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/refresh": {"post": {"tags": ["System"], "operationId": "refreshState", "summary": "Request asynchronous reconciliation", "parameters": [{"$ref": "#/components/parameters/CsrfToken"}], "responses": {"202": {"$ref": "#/components/responses/JsonObject"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/events": {"get": {"tags": ["System"], "operationId": "streamEvents", "summary": "Stream state events with Server-Sent Events", "parameters": [{"name": "Last-Event-ID", "in": "header", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "SSE event stream", "headers": {"X-Accel-Buffering": {"schema": {"type": "string", "const": "no"}}}, "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/auth/me": {"get": {"tags": ["Authentication"], "operationId": "getCurrentUser", "summary": "Get the current user and session-bound CSRF token", "responses": {"200": {"description": "Current authenticated session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/auth/login": {"post": {"tags": ["Authentication"], "operationId": "login", "summary": "Create a panel session", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "Authenticated session", "headers": {"Set-Cookie": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/auth/claim": {"post": {"tags": ["Authentication"], "operationId": "claimAccess", "summary": "Activate an invitation or recovery code", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClaimRequest"}}}}, "responses": {"200": {"description": "Activated session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/auth/logout": {"post": {"tags": ["Authentication"], "operationId": "logout", "summary": "Revoke the current session", "parameters": [{"$ref": "#/components/parameters/CsrfToken"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/auth/access": {"get": {"tags": ["Authentication"], "operationId": "listPanelAccess", "summary": "List player panel access", "x-craftcontrol-capability": "security.manage_users", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/auth/access/invite": {"post": {"tags": ["Authentication"], "operationId": "invitePanelUser", "summary": "Create an invitation or recovery code", "x-craftcontrol-capability": "security.manage_users", "parameters": [{"$ref": "#/components/parameters/CsrfToken"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["player", "role"], "properties": {"player": {"type": "string"}, "role": {"type": "string", "enum": ["viewer", "operator", "owner"]}}}}}}, "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/auth/access/{player}/suspend": {"put": {"tags": ["Authentication"], "operationId": "suspendPanelUser", "summary": "Suspend panel access and revoke sessions", "x-craftcontrol-capability": "security.manage_users", "parameters": [{"$ref": "#/components/parameters/PlayerPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/players": {"get": {"tags": ["Players"], "operationId": "listPlayers", "summary": "List permanent player profiles", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/players/profile/{identity}": {"get": {"tags": ["Players"], "operationId": "getPlayerProfile", "summary": "Get one player profile and history", "parameters": [{"name": "identity", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/players/{player}/operator": {"put": {"tags": ["Players"], "operationId": "setPlayerOperator", "summary": "Change Minecraft operator status", "x-craftcontrol-capability": "players.manage", "parameters": [{"$ref": "#/components/parameters/PlayerPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}}}, "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/analytics/activity": {"get": {"tags": ["Analytics"], "operationId": "getActivity", "summary": "Query filtered server activity", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}}, {"name": "kind", "in": "query", "schema": {"type": "string"}}, {"name": "player", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/analytics/rankings": {"get": {"tags": ["Analytics"], "operationId": "getRankings", "summary": "Get lifetime rankings", "parameters": [{"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/analytics/blocks": {"get": {"tags": ["Analytics"], "operationId": "getBlockAnalytics", "summary": "Get mining and building analytics", "parameters": [{"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/analytics/combat": {"get": {"tags": ["Analytics"], "operationId": "getCombatAnalytics", "summary": "Get combat analytics", "parameters": [{"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/analytics/exploration": {"get": {"tags": ["Analytics"], "operationId": "getExplorationAnalytics", "summary": "Get exploration analytics", "parameters": [{"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/analytics/periods": {"get": {"tags": ["Analytics"], "operationId": "getPeriodAnalytics", "summary": "Get daily and period analytics", "parameters": [{"name": "days", "in": "query", "schema": {"type": "integer", "enum": [7, 30]}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/telemetry-pack": {"get": {"tags": ["Telemetry"], "operationId": "getTelemetryPack", "summary": "Get Telemetry Pack lifecycle and runtime status", "responses": {"200": {"$ref": "#/components/responses/JsonObject"}}}},
    "/api/telemetry-pack/{action}": {"post": {"tags": ["Telemetry"], "operationId": "operateTelemetryPack", "summary": "Run an allowlisted Telemetry Pack operation", "x-craftcontrol-capability": "telemetry.manage", "parameters": [{"$ref": "#/components/parameters/ActionPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/server/{action}": {"post": {"tags": ["Server"], "operationId": "operateServer", "summary": "Run an allowlisted Bedrock lifecycle operation", "x-craftcontrol-capability": "server.control", "parameters": [{"$ref": "#/components/parameters/ActionPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/gamerules/{rule}": {"put": {"tags": ["World"], "operationId": "setGamerule", "summary": "Set one allowlisted gamerule", "x-craftcontrol-capability": "world.write", "parameters": [{"name": "rule", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/CsrfToken"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["value"], "properties": {"value": {}}}}}}, "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/world/{action}": {"post": {"tags": ["World"], "operationId": "operateWorld", "summary": "Run an allowlisted world operation", "x-craftcontrol-capability": "world.write", "parameters": [{"$ref": "#/components/parameters/ActionPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/time/{action}": {"post": {"tags": ["World"], "operationId": "operateTime", "summary": "Run an allowlisted time or weather operation", "x-craftcontrol-capability": "world.write", "parameters": [{"$ref": "#/components/parameters/ActionPath"}, {"$ref": "#/components/parameters/CsrfToken"}], "requestBody": {"$ref": "#/components/requestBodies/JsonObject"}, "responses": {"200": {"$ref": "#/components/responses/JsonObject"}, "400": {"$ref": "#/components/responses/BadRequest"}}}}
  },
  "components": {
    "securitySchemes": {"cookieAuth": {"type": "apiKey", "in": "cookie", "name": "craftcontrol_session", "description": "HttpOnly session cookie issued by login or claim."}},
    "parameters": {
      "CsrfToken": {"name": "X-CSRF-Token", "in": "header", "required": true, "description": "Session-bound token returned by /api/auth/me.", "schema": {"type": "string"}},
      "PlayerPath": {"name": "player", "in": "path", "required": true, "schema": {"type": "string"}},
      "ActionPath": {"name": "action", "in": "path", "required": true, "description": "Server-side allowlist remains authoritative.", "schema": {"type": "string"}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 10}}
    },
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}, "capability": {"type": "string"}}},
      "User": {"type": "object", "required": ["id", "name", "role", "capabilities"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string", "enum": ["viewer", "operator", "owner"]}, "capabilities": {"type": "array", "items": {"type": "string"}}}},
      "Session": {"type": "object", "required": ["user"], "properties": {"user": {"$ref": "#/components/schemas/User"}, "csrf_token": {"type": "string"}}},
      "LoginRequest": {"type": "object", "required": ["player", "password"], "properties": {"player": {"type": "string"}, "password": {"type": "string", "format": "password"}}},
      "ClaimRequest": {"type": "object", "required": ["player", "token", "password"], "properties": {"player": {"type": "string"}, "token": {"type": "string"}, "password": {"type": "string", "format": "password", "minLength": 8}}}
    },
    "requestBodies": {"JsonObject": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}},
    "responses": {
      "Ok": {"description": "Successful operation", "content": {"application/json": {"schema": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean", "const": true}}}}}},
      "JsonObject": {"description": "Successful JSON response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
      "BadRequest": {"description": "Invalid input or allowlisted operation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Authentication required or credentials rejected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "CSRF, origin, or capability check failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
