#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  (cd packs/telemetry && npm ci && npm run check)
  echo "telemetry gate: ok"
  exit 0
fi

command -v docker >/dev/null 2>&1 \
  || { echo "node/npm are unavailable and Docker is required for telemetry checks" >&2; exit 1; }

echo "node/npm not found on the host; running telemetry checks in Docker"
docker run --rm \
  --user "$(id -u):$(id -g)" \
  -e npm_config_cache=/tmp/npm-cache \
  -v "$ROOT:/workspace" \
  -w /workspace \
  node:22-alpine \
  sh -ec '
    cd packs/telemetry
    npm ci
    npm run check
  '
echo "telemetry gate: ok"
