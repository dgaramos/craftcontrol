#!/usr/bin/env bash
set -euo pipefail

readonly revision="${1:?expected revision}"
readonly state_root=/mnt/storage/docker/craftcontrol-bedrock-proxy-update
readonly request_file="$state_root/request"
readonly result_file="$state_root/result"
readonly timeout_seconds=90

[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo "invalid revision" >&2; exit 2; }
install -d -m 0755 "$state_root"
temporary="$(mktemp "$state_root/.request.XXXXXX")"
printf '%s\n' "$revision" > "$temporary"
chmod 0644 "$temporary"
mv -f "$temporary" "$request_file"

deadline=$((SECONDS + timeout_seconds))
while (( SECONDS < deadline )); do
  if [[ -f "$result_file" && ! -L "$result_file" ]]; then
    mapfile -t result < "$result_file"
    if [[ "${result[1]:-}" == "$revision" ]]; then
      [[ "${result[0]:-}" == activated ]] && exit 0
      printf 'host agent update %s\n' "${result[2]:-failed}" >&2
      exit 1
    fi
  fi
  sleep 1
done

echo "timed out waiting for host agent update" >&2
exit 1
