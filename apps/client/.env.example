# CraftControl frontend — local development environment
# Copy this file to .env and adjust for your setup.
# .env is gitignored; never commit it.
#
# Alternatively, export these vars in your shell profile or manage them with
# the `local-env` dotfiles tool:
#   local-env set CRAFTCONTROL_BACKEND http://192.168.15.50:8082

# URL of the running CraftControl backend (Flask via nginx).
# Defaults to http://localhost:8082 when unset.
CRAFTCONTROL_BACKEND=http://localhost:8082

# Local port for the dev proxy server. Defaults to 3333.
# PORT=3333
