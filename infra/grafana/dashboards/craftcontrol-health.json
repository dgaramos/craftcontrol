      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(craftcontrol_snapshot_duration_ms_total{job=\"craftcontrol\"}[5m]) / rate(craftcontrol_snapshot_total{job=\"craftcontrol\"}[5m])",
          "legendFormat": "avg duration",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "craftcontrol_snapshot_duration_ms_max{job=\"craftcontrol\"}",
          "legendFormat": "max duration",
          "refId": "B"
        }
