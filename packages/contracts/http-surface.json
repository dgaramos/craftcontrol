{
  "contract_version": 1,
  "public_origin": "frontend",
  "api_prefix": "/api",
  "sse_path": "/api/events",
  "routes": [
    {"path": "/", "methods": ["GET"], "owner": "frontend-compat"},
    {"path": "/api/analytics/activity", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/analytics/blocks", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/analytics/combat", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/analytics/exploration", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/analytics/periods", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/analytics/rankings", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/auth/access", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/auth/access/<path:player>/suspend", "methods": ["PUT"], "owner": "backend"},
    {"path": "/api/auth/access/invite", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/auth/claim", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/auth/login", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/auth/logout", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/auth/me", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/config", "methods": ["GET", "PUT"], "owner": "backend"},
    {"path": "/api/events", "methods": ["GET"], "owner": "backend", "protocol": "sse"},
    {"path": "/api/gamerules/<rule>", "methods": ["PUT"], "owner": "backend"},
    {"path": "/api/health", "methods": ["GET"], "owner": "backend", "public": true},
    {"path": "/api/players", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/players/<player>/operator", "methods": ["PUT"], "owner": "backend"},
    {"path": "/api/players/profile/<path:identity>", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/refresh", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/schema", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/server/<action>", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/state", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/status", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/telemetry-pack", "methods": ["GET"], "owner": "backend"},
    {"path": "/api/telemetry-pack/<action>", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/time/<action>", "methods": ["POST"], "owner": "backend"},
    {"path": "/api/world/<action>", "methods": ["POST"], "owner": "backend"},
    {"path": "/static/<path:filename>", "methods": ["GET"], "owner": "frontend-compat"}
  ]
}
