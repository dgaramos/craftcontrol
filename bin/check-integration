#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python}"
cd "$ROOT"

bash -n bin/deploy-craftcontrol
bash -n bin/deploy-craftcontrol-frontend
docker compose config --quiet
docker compose --file docker-compose.split.yml config --quiet
docker compose --file docker-compose.split.yml build
bin/check-split-runtime
"$PYTHON" -m unittest tests.test_architecture tests.test_deployment -v
echo "integration gate: ok"
