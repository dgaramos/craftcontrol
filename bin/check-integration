#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

bash -n bin/deploy-craftcontrol
bash -n bin/deploy-craftcontrol-frontend
bash -n bin/deploy-craftcontrol-backend
bash -n bin/deploy-craftcontrol-release
bash -n bin/check-split-auth
bash -n bin/cutover-craftcontrol-split
bash -n deploy/host-agent/bin/install-craftcontrol-storage-io-queue
docker compose config --quiet
docker compose --file docker-compose.split.yml config --quiet
docker compose --file docker-compose.split.yml build
bin/check-split-runtime
PYTHONPATH="$ROOT/apps/server${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -m pytest apps/server/tests/test_architecture.py apps/server/tests/test_deployment.py apps/server/tests/test_documentation.py -v
echo "integration gate: ok"
