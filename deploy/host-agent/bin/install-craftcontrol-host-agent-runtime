#!/usr/bin/env python3
"""Idempotent installer / preflight for the CraftControl Host Agent runtime.

Compose the production dependencies and dispatch to preflight.py.

Usage:
  sudo deploy/host-agent/bin/install-craftcontrol-host-agent-runtime [--dry-run]

Options:
  --dry-run   Report what would be changed without applying any mutation.

Security invariants:
  - All paths must be absolute (validated before any mutation).
  - Owner/group of pre-existing files are never changed.
  - /etc/craftcontrol/host-agent-token is never opened for writing.
  - Bedrock container files are never modified.
  - No systemd service is restarted (daemon-reload only).
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Optional

# Locate preflight.py relative to this script's repository position.
# deploy/host-agent/bin/ → root → services/host-agent/
_REPO_ROOT = Path(__file__).resolve().parents[3]
_AGENT_SRC = _REPO_ROOT / "services" / "host-agent"
if str(_AGENT_SRC) not in sys.path:
    sys.path.insert(0, str(_AGENT_SRC))

from preflight import (  # noqa: E402
    FakeFilesystem,
    Preflight,
    ProductionRunner,
    SystemInfo,
)


# ---------------------------------------------------------------------------
# Production filesystem implementation
# ---------------------------------------------------------------------------

_SERVICE = "craftcontrol-host-agent"
_ENV_ACL_UNIT = "craftcontrol-host-agent-env-acl"


def _is_group_member(
    *, agent_user: str, primary_gid: int, target_gid: int, groups: list[object],
) -> bool:
    """Return membership for the configured user, never for the invoking process."""
    return primary_gid == target_gid or any(
        agent_user in group.gr_mem for group in groups if group.gr_gid == target_gid
    )


class ProductionFilesystem:
    """Production implementation of filesystem / ACL queries."""

    def has_acl(self, path: str, user: str, perms: str) -> bool:
        try:
            out = subprocess.check_output(
                ["getfacl", "--omit-header", "--", path],
                stderr=subprocess.DEVNULL,
                text=True,
            )
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False
        # Look for default: prefix when checking default ACLs
        if perms.startswith("d:"):
            target = f"default:user:{user}:"
        else:
            target = f"user:{user}:"
        return any(line.startswith(target) for line in out.splitlines())

    def dropin_path(self, service: str) -> str:
        return f"/etc/systemd/system/{service}.service.d/runtime-paths.conf"

    def dropin_exists(self, service: str) -> bool:
        return Path(self.dropin_path(service)).exists()

    def dropin_content(self, service: str) -> Optional[str]:
        p = Path(self.dropin_path(service))
        return p.read_text() if p.exists() else None

    def write_dropin(self, service: str, content: str) -> None:
        dropin = Path(self.dropin_path(service))
        dropin.parent.mkdir(parents=True, exist_ok=True)
        dropin.write_text(content)

    def write_file(self, path: str, content: str) -> None:
        Path(path).write_text(content)

    def path_unit_active(self, unit: str) -> bool:
        result = subprocess.run(
            ["systemctl", "is-active", "--quiet", unit],
            check=False,
        )
        return result.returncode == 0

    def run_sandbox_validation(
        self,
        *,
        agent_user: str,
        bedrock_data: str,
        agent_state_dir: str,
        compose_file: str,
        compose_project: str,
        docker_config: str,
    ) -> bool:
        cmd = [
            "systemd-run",
            "--wait",
            "--collect",
            "--pipe",
            "--quiet",
            f"--property=User={agent_user}",
            f"--property=Group={agent_user}",
            "--property=NoNewPrivileges=yes",
            "--property=PrivateTmp=yes",
            "--property=ProtectSystem=strict",
            f"--property=ReadWritePaths={bedrock_data} {agent_state_dir}",
            f"--property=ReadOnlyPaths=/etc/craftcontrol {Path(compose_file).parent}",
            f"--setenv=DOCKER_CONFIG={docker_config}",
            "/bin/sh",
            "-ceu",
            (
                "compose_root=$(dirname \"$1\"); "
                "test -r \"$compose_root/.env\"; "
                "test -w \"$2\"; "
                "docker compose --project-name \"$3\" --file \"$1\" config --quiet"
            ),
            "sh",
            compose_file,
            bedrock_data,
            compose_project,
        ]
        result = subprocess.run(cmd, check=False)
        return result.returncode == 0


# ---------------------------------------------------------------------------
# System info probe
# ---------------------------------------------------------------------------


def _probe_system(agent_user: str) -> SystemInfo:
    def _available(cmd: str) -> bool:
        return shutil.which(cmd) is not None

    def _run_ok(*args: str) -> bool:
        try:
            subprocess.check_output(list(args), stderr=subprocess.DEVNULL)
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    compose_v2 = _run_ok("docker", "compose", "version")

    # Check agent user exists
    try:
        import pwd  # noqa: PLC0415
        pwd.getpwnam(agent_user)
        user_exists = True
    except KeyError:
        user_exists = False

    # Check docker group membership
    try:
        import grp  # noqa: PLC0415
        docker_gid = grp.getgrnam("docker").gr_gid
        import pwd as _pwd  # noqa: PLC0415
        pw = _pwd.getpwnam(agent_user)
        in_docker = _is_group_member(
            agent_user=agent_user,
            primary_gid=pw.pw_gid,
            target_gid=docker_gid,
            groups=grp.getgrall(),
        )
    except (KeyError, PermissionError):
        in_docker = False

    return SystemInfo(
        python_version=sys.version_info[:3],
        docker_available=_available("docker"),
        compose_v2=compose_v2,
        setfacl_available=_available("setfacl"),
        agent_user_exists=user_exists,
        agent_in_docker_group=in_docker,
    )


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main() -> None:
    dry_run = "--dry-run" in sys.argv

    project_root = os.environ.get("HOST_AGENT_COMPOSE_FILE", "/opt/craftcontrol/docker-compose.yml")
    project_root = str(Path(project_root).parent)
    compose_file = os.environ.get("HOST_AGENT_COMPOSE_FILE", "/opt/craftcontrol/docker-compose.yml")
    bedrock_data = os.environ.get("HOST_AGENT_BEDROCK_DATA", "/opt/minecraft-bedrock")
    agent_user = os.environ.get("HOST_AGENT_USER", "craftcontrol-agent")
    compose_project = os.environ.get("HOST_AGENT_COMPOSE_PROJECT", "minecraft-bedrock")
    agent_state_dir = os.environ.get("HOST_AGENT_STATE_DIR", "/var/lib/craftcontrol/host-agent")
    docker_config = os.environ.get("DOCKER_CONFIG", f"{agent_state_dir}/docker")

    system_info = _probe_system(agent_user)
    runner = ProductionRunner()
    fs = ProductionFilesystem()

    pf = Preflight(
        project_root=project_root,
        bedrock_data=bedrock_data,
        agent_user=agent_user,
        compose_file=compose_file,
        compose_project=compose_project,
        system_info=system_info,
        runner=runner,
        fs=fs,
        dry_run=dry_run,
        agent_state_dir=agent_state_dir,
        docker_config=docker_config,
    )

    result = pf.run()

    if dry_run and result.planned_actions:
        print("Planned actions:")
        for action in result.planned_actions:
            print(f"  - {action}")

    if not result.success:
        print(f"preflight failed: {result.error}", file=sys.stderr)
        sys.exit(1)

    if not dry_run:
        print("Host agent runtime prerequisites satisfied.")


if __name__ == "__main__":
    main()
