#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python}"
cd "$ROOT"

while IFS= read -r source; do
  node --check "$source"
done < <(rg --files apps/frontend/static -g '*.js' | sort)

node apps/frontend/scripts/check-i18n.mjs
node apps/frontend/scripts/check-dom-interactions.mjs
"$PYTHON" -m pytest tests/test_brand.py -v
(cd apps/frontend && npm ci && npm test)
echo "frontend gate: ok"
