#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

"$PYTHON" -m json.tool packages/contracts/openapi.json >/dev/null
"$PYTHON" packages/contracts/generate_types.py --check
"$PYTHON" -m pytest apps/server/tests/test_http_surface.py apps/server/tests/test_openapi.py -v
echo "contracts gate: ok"
