#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

run_node_checks() {
  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    while IFS= read -r source; do
      node --check "$source"
    done < <(find apps/client/static -type f -name '*.js' | sort)

    node apps/client/scripts/check-i18n.mjs
    node apps/client/scripts/check-dom-interactions.mjs
    (cd apps/client && npm ci && npm test -- --testPathIgnorePatterns='.*-contracts\.test\.js$' --coverage)
    return
  fi

  command -v docker >/dev/null 2>&1 \
    || { echo "node/npm are unavailable and Docker is required for frontend checks" >&2; exit 1; }

  echo "node/npm not found on the host; running frontend checks in Docker"
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e npm_config_cache=/tmp/npm-cache \
    -v "$ROOT:/workspace" \
    -w /workspace \
    node:22-alpine \
    sh -ec '
      find apps/client/static -type f -name "*.js" | sort | while IFS= read -r source; do
        node --check "$source"
      done
      node apps/client/scripts/check-i18n.mjs
      node apps/client/scripts/check-dom-interactions.mjs
      cd apps/client
      npm ci
      npm test -- --testPathIgnorePatterns=".*-contracts\.test\.js$" --coverage
    '
}

run_node_checks
echo "frontend gate: ok"
