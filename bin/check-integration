#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
readonly PYTHON="${PYTHON:-python3}"
cd "$ROOT"

docker compose config --quiet
docker compose --file docker-compose.split.yml config --quiet
docker compose --file docker-compose.split.yml build
bin/check-split-runtime
PYTHONPATH="$ROOT/apps/server/controlplane${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -m pytest apps/server/controlplane/tests/test_architecture.py apps/server/controlplane/tests/test_documentation.py -v
echo "integration gate: ok"
